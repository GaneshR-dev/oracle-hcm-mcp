{
  "name": "oracle-hcm-mcp",
  "version": "0.4.0",
  "description": "Unofficial Oracle Fusion Cloud HCM MCP server (stdio / Streamable HTTP / gRPC). Not affiliated with Oracle.",
  "type": "module",
  "license": "MIT",
  "author": "GaneshR-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaneshR-dev/oracle-hcm-mcp.git"
  },
  "bin": {
    "oracle-hcm-mcp": "./dist/index.js",
    "dummy-hcm": "./dist/dummy-hcm/index.js"
  },
  "files": [
    "dist",
    "proto",
    "docs",
    "README.md",
    "LICENSE",
    "setup-ui",
    "scripts/setup-ui-server.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dummy-hcm": "tsx src/dummy-hcm/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e-transport": "vitest run tests/transport-e2e.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup-ui": "node scripts/setup-ui-server.mjs",
    "e2e:http-grpc": "node scripts/e2e-http-grpc.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "mcp",
    "oracle",
    "hcm",
    "fusion",
    "model-context-protocol",
    "unofficial"
  ]
}
