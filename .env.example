# Unofficial Oracle HCM MCP — local / sandbox only. Never commit real secrets.
ORACLE_HCM_BASE_URL=http://127.0.0.1:9090/hcmRestApi
ORACLE_HCM_AUTH=basic
ORACLE_HCM_USERNAME=demo
ORACLE_HCM_PASSWORD=demo
# ORACLE_HCM_AUTH=oauth
# ORACLE_HCM_TOKEN_URL=https://idcs.example.com/oauth2/v1/token
# ORACLE_HCM_CLIENT_ID=
# ORACLE_HCM_CLIENT_SECRET=
# ORACLE_HCM_WRITE=1

# Sensitive tools AND resource roots (payslip/bank/national ID/comp/payroll):
# required in default mode. --write bypasses.
# ORACLE_HCM_SENSITIVE=1
# ORACLE_HCM_SENSITIVE_WRITE=1
# ORACLE_HCM_PROFILE=sandbox

# v0.7 — split-principal approvals (never returned by tools)
# ORACLE_HCM_APPROVAL_TOKEN=generate-a-long-random-hex
# HTTP/gRPC bearer (defaults to approval token)
# ORACLE_HCM_HTTP_TOKEN=
# Debug only — do not disable auth on a reachable bind
# ORACLE_HCM_HTTP_AUTH_OFF=0

# Fusion REST headers
# ORACLE_HCM_REST_FRAMEWORK_VERSION=4
# ORACLE_HCM_IF_MATCH=*
# ORACLE_HCM_ADF_CONTENT_TYPE=0
# ORACLE_HCM_EFFECTIVE_OF=

# v0.4 — multi-node approvals (file|sqlite|memory)
# ORACLE_HCM_APPROVAL_STORE=file
# ORACLE_HCM_APPROVAL_STORE_PATH=/tmp/oracle-hcm-mcp/approvals.json

# v0.4 — webhook HMAC (X-HCM-Signature: sha256=<hex>)
# ORACLE_HCM_WEBHOOK_SECRET=change-me

# v0.4 — Atom CDC checkpoint file
# ORACLE_HCM_ATOM_CHECKPOINT_PATH=/tmp/oracle-hcm-mcp/atom-checkpoints.json
# ORACLE_HCM_ATOM_CHECKPOINT=file

# v0.5 multi-env / smoke / webhook rotation
# ORACLE_HCM_PROFILES_PATH=/path/to/profiles.json
# ORACLE_HCM_SMOKE_DIR=/path/to/smoke
# ORACLE_HCM_WEBHOOK_SECRETS=oldsecret,newsecret
# ORACLE_HCM_WEBHOOK_MTLS=0
# ORACLE_HCM_WEBHOOK_TLS_KEY=
# ORACLE_HCM_WEBHOOK_TLS_CERT=
# ORACLE_HCM_WEBHOOK_TLS_CA=
# ORACLE_HCM_RATE_CAPACITY=40
# ORACLE_HCM_RATE_REFILL=12
# ORACLE_HCM_HTTP_RETRIES=4

# v0.6/v0.7 webhook replay — required when signing is on
# ORACLE_HCM_WEBHOOK_REPLAY_PROTECTION=1
# ORACLE_HCM_WEBHOOK_REPLAY_WINDOW_MS=300000
